# Non-secret SMTP parameters for the booking-confirmation function.
# Copy to functions/.env.tour-registration-1727d and fill in. NEVER put the password
# here — that lives in Secret Manager:  npx firebase-tools functions:secrets:set SMTP_PASS
#
# Google Workspace (recommended for n24.sa):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tours@n24.sa
MAIL_FROM=Tour Registration <tours@n24.sa>

# SendGrid:  SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=465  SMTP_USER=apikey
# Resend:    SMTP_HOST=smtp.resend.com    SMTP_PORT=465  SMTP_USER=resend

# Where the trigger runs. Firestore is in me-central2, so the function goes there too.
# If a deploy is refused for the region, set the nearest supported one here.
FUNCTION_REGION=me-central2
FIRESTORE_DATABASE=(default)
