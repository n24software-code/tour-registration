# Supabase (Project Settings → API). The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only — bypasses row level security. Never expose this to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Only the Supabase CLI uses this (Project Settings → Database → Database password).
SUPABASE_DB_PASSWORD=

# Absolute origin of the deployed site: the confirmation email's logos and booking
# link can't resolve a relative URL. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# SMTP for booking confirmations. Google Workspace needs an App Password, not the
# account password. SendGrid: smtp.sendgrid.net / user "apikey". Resend: smtp.resend.com.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tours@example.com
SMTP_PASS=
MAIL_FROM="Tour Registration <tours@example.com>"

# Optional: lets a scheduler call /api/outbox/retry with a bearer token.
CRON_SECRET=
