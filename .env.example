# Firebase web app (Project settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Admin SDK (Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Absolute origin of the deployed site. Used for the logo and booking links in the
# confirmation email, which cannot resolve relative URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# The From address on booking confirmations. Leave empty to use the Trigger Email
# extension's own default sender. Must be an address your SMTP provider may send as.
MAIL_FROM="Tour registration <no-reply@example.com>"
